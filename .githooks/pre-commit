#!/usr/bin/env bash
# Shim: record admission routes through the single gate (intent/gate.sh).
# Registered in intent/SURFACES.md.
# Install: git config core.hooksPath .githooks
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"

# kb generated docs must match .kb data. Converge best effort: skip silently
# when bun is missing (fresh machine); the check itself failing is a real stop.
if [ -d "$repo_root/tools/kb" ] && [ -d "$repo_root/.kb" ]; then
  if command -v bun >/dev/null 2>&1; then
    (cd "$repo_root" && bun tools/kb/src/bin/docs-check.ts)
  fi
fi

# kb TS7 typecheck gate: zero-error `tsc --noEmit` on the backend and UI
# packages. Runs whenever anything under tools/kb changed. Skips silently when
# node_modules is absent (fresh machine); a real type error is a hard stop.
if git diff --cached --name-only --diff-filter=ACMRD | grep -q '^tools/kb/'; then
  for pkg in tools/kb tools/kb/ui; do
    if [ -x "$repo_root/$pkg/node_modules/.bin/tsc" ]; then
      echo "==> typecheck ($pkg)"
      (cd "$repo_root/$pkg" && ./node_modules/.bin/tsc --noEmit)
    fi
  done
fi

exec "$repo_root/intent/gate.sh" record git-commit
