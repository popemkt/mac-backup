{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "types": ["bun"],

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  },
  // Backend package only. The browser app lives in ui/ with its own tsconfig;
  // dragging it into this project makes `tsc --noEmit` surface UI errors that
  // belong to ui/tsconfig.json and pulls in DOM/jsx/alias assumptions the
  // backend doesn't share.
  "include": ["index.ts", "src", "tests", "extensions-bundled"],
  "exclude": ["ui"]
}
