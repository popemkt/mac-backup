{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "react", "import", "unicorn", "oxc"],
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "**/storybook-static/**"
  ],
  "rules": {
    "import/no-cycle": ["error", { "maxDepth": 8 }],
    "react/exhaustive-deps": "error",
    "typescript/ban-ts-comment": ["error", { "ts-expect-error": "allow-with-description" }],
    "typescript/no-explicit-any": "warn"
  },
  "overrides": [
    {
      "files": [
        "packages/model/src/**",
        "packages/canvas/src/**",
        "packages/query/src/**",
        "packages/contracts/src/**"
      ],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^(?:node:|bun:|@effect/platform-bun)",
                "message": "Isomorphism fence: layer and scope direction are enforced by the package graph (packages/harness `boundaries`); this is the one restriction that graph cannot see. A scope:shared package runs in the browser as well as in Bun, so no node:*, bun:* or @effect/platform-bun — move the host-specific part to a scope:backend package."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["**/*.css"],
      "rules": {}
    }
  ]
}
