{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "harness/tests/*.test.ts",
        "harness/lint/*/index.ts",
        "harness/lint/*/effect/index.ts",
        "harness/lint/**/*.rule-cases.ts"
      ]
    },
    "packages/app/cli": {
      "entry": [
        "src/bin/*.ts"
      ]
    },
    "packages/contract/ext-sdk": {
      "entry": [
        "scripts/generate.ts",
        "tests/*.test.ts"
      ]
    },
    "packages/test-support/render-tests": {
      "entry": [
        "playwright.config.ts",
        "tests-render/*.e2e.ts",
        "tests-render/global-setup.ts",
        "tests-render/server.ts"
      ]
    },
    "packages/app/ui": {
      "entry": [
        "vite.sandbox.config.ts",
        "src/sandbox/frame.ts"
      ]
    },
    "packages/app/test-kit": {
      "entry": [
        "tests/*.test.ts",
        "tests/run-many.ts"
      ]
    }
  },
  "ignore": [
    "packages/contract/ext-sdk/src/surface.ts"
  ],
  "ignoreFiles": [
    "packages/app/ui/src/api/queries.ts"
  ],
  "ignoreDependencies": [
    "graphology-communities-louvain",
    "graphology-layout",
    "graphology-layout-noverlap"
  ]
}
