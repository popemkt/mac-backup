{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "index.ts",
        "src/surface/cli.ts",
        "src/surface/ui.ts",
        "src/surface/mcp.ts"
      ],
      "project": [
        "src/**/*.ts",
        "extensions-bundled/**/*.ts"
      ]
    },
    "ui": {
      "entry": [
        "src/main.tsx"
      ],
      "project": [
        "src/**/*.{ts,tsx}"
      ],
      "paths": {
        "@/*": [
          "src/*"
        ],
        "@kb/protocol": [
          "../src/surface/protocol.ts"
        ],
        "@kb/canvas": [
          "../src/canvas/doc.ts"
        ],
        "@kb/ontology": [
          "../src/foundation/ontology.ts"
        ],
        "@kb/order": [
          "../src/foundation/order.ts"
        ],
        "@kb/field-type": [
          "../src/foundation/field-type.ts"
        ]
      }
    }
  },
  "ignoreFiles": [
    "src/bin/docs-check.ts",
    "src/bin/docs-materialize.ts",
    "src/ext-sdk/surface.ts",
    "ui/src/api/queries.ts",
    "ui/src/components/canvas/index.tsx"
  ],
  "ignoreDependencies": [
    "@fontsource-variable/outfit",
    "graphology-communities-louvain",
    "graphology-layout",
    "graphology-layout-noverlap",
    "tailwindcss",
    "zod"
  ]
}
