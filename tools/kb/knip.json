{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "packages/cli": {
      "entry": [
        "src/bin/*.ts"
      ]
    },
    "packages/ext-sdk": {
      "entry": [
        "scripts/generate.ts",
        "tests/*.test.ts"
      ]
    },
    "packages/harness": {
      "entry": [
        "tests/*.test.ts"
      ]
    },
    "packages/render-tests": {
      "entry": [
        "playwright.config.ts",
        "tests-render/*.e2e.ts",
        "tests-render/global-setup.ts",
        "tests-render/server.ts"
      ]
    },
    "packages/test-kit": {
      "entry": [
        "tests/*.test.ts",
        "tests/run-many.ts"
      ]
    }
  },
  "ignoreFiles": [
    "packages/ext-sdk/src/surface.ts",
    "packages/ui/src/api/queries.ts",
    "packages/ui/src/components/canvas/index.tsx"
  ],
  "ignoreDependencies": [
    "graphology-communities-louvain",
    "graphology-layout",
    "graphology-layout-noverlap",
    "zod"
  ]
}
