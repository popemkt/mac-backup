{
  "name": "kb",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "kb": "./src/surface/cli.ts"
  },
  "scripts": {
    "test": "bun test",
    "test:mutation": "stryker run",
    "bench": "bun test tests/benchmark.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "vp lint",
    "check": "vp check --no-fmt",
    "lint:all": "oxlint --config .oxlintrc.json index.ts src ui/src extensions-bundled",
    "knip": "knip --include files,dependencies",
    "verify": "npm run typecheck && npm run check && npm run lint:all && npm run knip",
    "fmt": "vp fmt",
    "gen:ext-sdk": "bun scripts/gen-ext-sdk.ts"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.0-beta.106",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^13.1.0",
    "datascript": "^1.7.8",
    "effect": "4.0.0-beta.106",
    "ulid": "^3.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@types/bun": "^1.3.14",
    "fast-check": "^4.9.0",
    "knip": "6.32.2",
    "typescript": "^7.0.2",
    "vite-plus": "0.2.8",
    "vitest": "4.1.10"
  }
}
