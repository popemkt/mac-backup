{
  "name": "kb",
  "version": "0.1.0",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "3d-force-graph": "^1.80.0",
      "@effect/platform-bun": "4.0.0-rc.112",
      "@effect/tsgo": "^0.40.0",
      "@fontsource-variable/inter": "^5.3.0",
      "@fontsource-variable/outfit": "^5.3.0",
      "@modelcontextprotocol/sdk": "^1.30.0",
      "@phosphor-icons/react": "^2.1.10",
      "@storybook/addon-a11y": "^10.5.10",
      "@storybook/react": "^10.5.10",
      "@storybook/react-vite": "^10.5.10",
      "@stryker-mutator/core": "10.0.0",
      "@tailwindcss/vite": "^4.0.6",
      "@types/bun": "^1.3.14",
      "@types/d3-hierarchy": "^3.1.7",
      "@types/react": "^19.2.0",
      "@types/react-dom": "^19.2.0",
      "@vitejs/plugin-react": "^5.0.4",
      "clsx": "^2.1.1",
      "commander": "^13.1.0",
      "d3-hierarchy": "^3.1.2",
      "datascript": "^1.8.1",
      "effect": "4.0.0-rc.112",
      "fast-check": "^4.9.0",
      "graphology": "^0.26.0",
      "graphology-communities-louvain": "2.0.2",
      "graphology-layout": "0.6.1",
      "graphology-layout-forceatlas2": "^0.10.1",
      "graphology-layout-noverlap": "0.4.2",
      "happy-dom": "^20.11.2",
      "knip": "6.32.2",
      "nx": "^23.1.2",
      "oxlint": "^1.76.0",
      "oxlint-tsgolint": "^7.0.2001",
      "playwright": "^1.62.1",
      "react": "^19.2.0",
      "react-dom": "^19.2.0",
      "sigma": "^3.0.3",
      "storybook": "^10.5.10",
      "tailwind-merge": "^3.4.0",
      "tailwindcss": "^4.0.6",
      "three": "^0.180.0",
      "typescript": "~7.0.2",
      "ulid": "^3.0.2",
      "vitest": "4.1.10",
      "zod": "^4.4.3",
      "zustand": "^5.0.9"
    }
  },
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch",
    "typecheck": "nx run-many -t typecheck",
    "test": "bun test packages",
    "test:ui": "bun run --filter @kb/ui test",
    "test:dst": "bun packages/test-kit/tests/run-many.ts 25",
    "test:mutation": "stryker run",
    "bench": "bun test packages/store-jsonl/tests/benchmark.test.ts",
    "lint": "oxlint --config .oxlintrc.json --type-aware packages",
    "fmt": "vp fmt packages",
    "fmt:check": "vp fmt packages --check",
    "knip": "knip --include files,dependencies,exports,types,nsExports,nsTypes,duplicates --no-exit-code",
    "harness": "bun test packages/harness",
    "harness:snapshot": "bun packages/harness/src/snapshot.ts",
    "affected": "nx affected -t typecheck,test --base=main",
    "gen:ext-sdk": "bun packages/ext-sdk/src/generate.ts",
    "verify": "bun run typecheck && bun run lint && bun run fmt:check && bun run knip && bun run harness"
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:",
    "@stryker-mutator/core": "catalog:",
    "@types/bun": "catalog:",
    "knip": "catalog:",
    "nx": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "0.2.8"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.8",
    "vitest": "4.1.10"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "12.0.2",
      "onFail": "download"
    }
  }
}
