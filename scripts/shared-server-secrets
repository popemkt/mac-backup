#!/usr/bin/env bash
# One-time bootstrap secrets for shared-server.
#
# Passwords and the Tailscale auth key become machine state (shadow file,
# tailscaled's node key); they never belong in this repository or the Nix
# store. A person fills a private file, this script applies it, then deletes
# it. Agents run this script but never read the file: whatever an agent reads
# enters its transcript.
#
#   scripts/shared-server-secrets init    write the template, mode 0600
#   scripts/shared-server-secrets apply   apply every non-empty value, delete
#
# Run as a wheel user after the host has switched to the repo configuration,
# so both accounts exist. The file defaults to ~/shared-server-secrets.env,
# outside the repository; SHARED_SERVER_SECRETS overrides it.
set -euo pipefail

file="${SHARED_SERVER_SECRETS:-$HOME/shared-server-secrets.env}"

# Read one key without sourcing the file, so values may hold any character.
value() {
  sed -n "s/^$1=//p" "$file" | tail -n 1
}

set_password() {
  local user="$1" password="$2"
  [ -n "$password" ] || return 0
  if ! id "$user" > /dev/null 2>&1; then
    echo "error: user $user does not exist yet; switch the host first" >&2
    return 1
  fi
  printf '%s:%s\n' "$user" "$password" | sudo chpasswd
  echo "set password for $user"
}

tailscale_login() {
  local key="$1" key_file
  [ -n "$key" ] || return 0
  # Pass the key as a file so it never appears in the process list.
  key_file="$(mktemp)"
  trap 'rm -f "$key_file"' RETURN
  printf '%s' "$key" > "$key_file"
  sudo tailscale up --auth-key="file:$key_file"
  echo "joined the tailnet"
}

case "${1:-}" in
  init)
    if [ -e "$file" ]; then
      echo "error: $file already exists" >&2
      exit 1
    fi
    umask 077
    cat > "$file" << 'EOF'
# shared-server bootstrap secrets. Fill in, save, then run:
#   scripts/shared-server-secrets apply
# Leave a value empty to skip it. This file is deleted once everything applies.

# Optional: popemkt already has the password chosen in the installer.
POPEMKT_PASSWORD=
# Temporary; bytetum changes it with `passwd` on first login.
BYTETUM_PASSWORD=
# Tailscale console > Settings > Keys: a one-off key tagged tag:shared-server.
# The tag must already exist in configs/tailscale/policy.hujson on main.
TAILSCALE_AUTHKEY=
EOF
    echo "fill in $file, then run: $0 apply"
    ;;
  apply)
    if [ ! -f "$file" ]; then
      echo "error: $file not found; run: $0 init" >&2
      exit 1
    fi
    set_password popemkt "$(value POPEMKT_PASSWORD)"
    set_password bytetum "$(value BYTETUM_PASSWORD)"
    tailscale_login "$(value TAILSCALE_AUTHKEY)"
    # Overwrite before unlinking; on an SSD this is best effort.
    shred -u "$file" 2> /dev/null || rm -f "$file"
    echo "applied and deleted $file"
    ;;
  *)
    echo "usage: $0 init|apply" >&2
    exit 2
    ;;
esac
