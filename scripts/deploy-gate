#!/usr/bin/env bash
# deploy-gate: move the deploy branch forward to the newest main commit that
# CI has fully passed. shared-server applies deploy by itself
# (modules/stacks/pull-deploy); .github/workflows/deploy.yml runs this.
# How it decides: docs/deploys.md → The gate.
#
# A candidate commit X is green when
#   - Validate (validate.yml, every push to main) passed on X itself, and
#   - if the paths of the one workflow that writes Tailscale state
#     (tailscale-reconcile.yml) changed between deploy and X, there is
#     positive evidence it passed for that change. Let L be the last
#     first-parent commit up to X that touched its paths: at least one run
#     of it exists on a commit from L to X, all of them have ended, and the
#     newest succeeded. Each run reconciles main as it is when the run
#     starts, which for a run triggered from L on includes L, and nothing
#     it watches changed after L, so that run applied X's state or a newer
#     one. A run GitHub has not listed yet is no evidence, and L is found
#     in the whole history, not only the commits looked at, so a failure
#     older than the window still counts;
#   - no run of it on a commit between deploy and X is still going.
# Any failed read of the Actions API ends the gate without a decision.
# Only main's first-parent commits after deploy are candidates; deploy moves
# to the newest green one with a plain push (fast-forward only: the remote
# refuses anything else), never backwards.
#
# Environment: GITHUB_REPOSITORY (owner/name, for the runs API, through
# `gh api`), DEPLOY_GATE_REMOTE (origin), DEPLOY_GATE_MAIN (main),
# DEPLOY_GATE_BRANCH (deploy), DEPLOY_GATE_WINDOW (candidates looked at, 50),
# DEPLOY_GATE_EVIDENCE_MAX (commits read for one workflow's evidence, 100;
# more fails closed).
# `deploy-gate --print-watched` prints each watched workflow and path filter.
set -euo pipefail

own_workflow=.github/workflows/validate.yml
# The push path filters of each watched workflow, as in its `on.push.paths`
# (checks.*.deploy-gate-check fails when they drift apart).
declare -A watched=(
  [.github/workflows/tailscale-reconcile.yml]="configs/tailscale/policy.hujson
flake.nix
flake.lock
hosts/**
modules/**
.github/workflows/tailscale-reconcile.yml"
)

if [[ "${1:-}" == --print-watched ]]; then
  for workflow in "${!watched[@]}"; do
    while IFS= read -r glob; do printf '%s\t%s\n' "$workflow" "$glob"; done <<<"${watched[$workflow]}"
  done
  exit 0
fi

repo="${GITHUB_REPOSITORY:?GITHUB_REPOSITORY must name owner/repo}"
remote="${DEPLOY_GATE_REMOTE:-origin}"
main="${DEPLOY_GATE_MAIN:-main}"
deploy="${DEPLOY_GATE_BRANCH:-deploy}"
window="${DEPLOY_GATE_WINDOW:-50}"
evidence_max="${DEPLOY_GATE_EVIDENCE_MAX:-100}"

git fetch --quiet "$remote" "+refs/heads/$main:refs/remotes/$remote/$main"
main_ref="refs/remotes/$remote/$main"

deploy_tip=""
if git ls-remote --exit-code --heads "$remote" "$deploy" >/dev/null; then
  git fetch --quiet "$remote" "+refs/heads/$deploy:refs/remotes/$remote/$deploy"
  deploy_tip="$(git rev-parse "refs/remotes/$remote/$deploy")"
  if ! git merge-base --is-ancestor "$deploy_tip" "$main_ref"; then
    echo "::error::$deploy ($deploy_tip) has commits $main lacks; fix it by hand (docs/deploys.md)." >&2
    exit 1
  fi
fi

# Candidates, oldest first: main's first-parent commits after deploy.
mapfile -t commits < <(git rev-list --first-parent --reverse --max-count="$window" \
  "$main_ref" ${deploy_tip:+"^$deploy_tip"})
if ((${#commits[@]} == 0)); then
  echo "deploy-gate: $deploy is at $main (${deploy_tip:-none}); nothing to move."
  exit 0
fi

cache="$(mktemp -d)"
trap 'rm -rf "$cache"' EXIT

# load_runs <sha>...: read each commit's gating runs on main from the
# Actions API into the cache, as a JSON array of {sha, path, id, status,
# conclusion}. A failed or malformed read ends the gate (exit 1): no answer
# is never taken for "no runs". Only a good answer is cached.
load_runs() {
  local sha raw
  for sha in "$@"; do
    [[ -f "$cache/$sha" ]] && continue
    raw="$cache/$sha.raw"
    if ! gh api "repos/$repo/actions/runs?head_sha=$sha&per_page=100" >"$raw" ||
      ! jq -c --arg sha "$sha" --arg main "$main" '
        if (.workflow_runs | type) != "array" then error("no workflow_runs") else . end
        | [.workflow_runs[]
          | select(.head_branch == $main and (.event == "push" or .event == "workflow_dispatch"))
          | {sha: $sha, path: (.path | split("@")[0]), id, status, conclusion}]' "$raw" >"$cache/$sha.new"; then
      echo "::error::could not read the Actions runs of $sha; deciding nothing." >&2
      exit 1
    fi
    mv "$cache/$sha.new" "$cache/$sha"
  done
}

# runs_of <sha>...: the cached runs of those commits, one array each
# (load_runs first, outside any pipeline, so its exit ends the gate).
runs_of() {
  local sha
  for sha in "$@"; do cat "$cache/$sha"; done
}

# passed <workflow> <sha>...: runs of <workflow> exist on those commits, all
# have ended, and the newest succeeded.
passed() {
  local workflow="$1"
  shift
  load_runs "$@"
  runs_of "$@" |
    jq -se --arg w "$workflow" '[.[][] | select(.path == $w)]
      | length > 0 and all(.[]; .status == "completed") and (max_by(.id).conclusion == "success")' >/dev/null
}

# going <workflow> <sha>...: a run of <workflow> on those commits has not ended.
going() {
  local workflow="$1"
  shift
  load_runs "$@"
  runs_of "$@" |
    jq -se --arg w "$workflow" 'any(.[][]; .path == $w and .status != "completed")' >/dev/null
}

# green <index>: whether candidate <index> is green; says why not.
green() {
  local i="$1" x="${commits[$1]}" workflow last evidence glob
  local -a specs
  if ! passed "$own_workflow" "$x"; then
    echo "deploy-gate: $x: Validate has not passed on it."
    return 1
  fi
  for workflow in "${!watched[@]}"; do
    if going "$workflow" "${commits[@]:0:i+1}"; then
      echo "deploy-gate: $x: a $workflow run since $deploy is still going."
      return 1
    fi
    specs=()
    while IFS= read -r glob; do specs+=(":(glob)$glob"); done <<<"${watched[$workflow]}"
    last="$(git log -1 --first-parent --format=%H "$x" -- "${specs[@]}")"
    # Unchanged since deploy (or ever): nothing of it to wait for.
    if [[ -z "$last" ]] || { [[ -n "$deploy_tip" ]] && git merge-base --is-ancestor "$last" "$deploy_tip"; }; then
      continue
    fi
    mapfile -t evidence < <(git rev-list --first-parent "$x" "^$last"; echo "$last")
    if ((${#evidence[@]} > evidence_max)); then
      echo "deploy-gate: $x: $workflow last changed ${#evidence[@]} commits earlier, more than the $evidence_max read; holding."
      return 1
    fi
    if ! passed "$workflow" "${evidence[@]}"; then
      echo "deploy-gate: $x: $workflow has not passed for its change at $last."
      return 1
    fi
  done
}

target=""
for ((i = ${#commits[@]} - 1; i >= 0; i--)); do
  if green "$i"; then
    target="${commits[$i]}"
    break
  fi
done

if [[ -z "$target" ]]; then
  echo "deploy-gate: no commit after $deploy (${deploy_tip:-none}) on $main is green yet; $deploy stays."
  exit 0
fi

echo "deploy-gate: moving $deploy from ${deploy_tip:-nothing} to $target."
if git push --quiet "$remote" "$target:refs/heads/$deploy"; then
  echo "deploy-gate: $deploy is at $target."
  exit 0
fi

# Refused: someone moved deploy meanwhile. Fine if it is at or past target.
git fetch --quiet "$remote" "+refs/heads/$deploy:refs/remotes/$remote/$deploy"
now="$(git rev-parse "refs/remotes/$remote/$deploy")"
if git merge-base --is-ancestor "$target" "$now"; then
  echo "deploy-gate: $deploy moved to $now meanwhile, which includes $target; nothing to do."
  exit 0
fi
echo "::error::pushing $target to $deploy was refused, and $deploy ($now) does not include it." >&2
exit 1
