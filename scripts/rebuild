#!/usr/bin/env bash
# Apply this repository's system configuration (nix-darwin on macOS, NixOS on
# Linux), then optionally run read-only checks.
# REBUILD_DRY_RUN=1 prints the switch command instead of running it.
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
skip_checks=false

if [[ "${1:-}" == "--no-checks" ]]; then
  skip_checks=true
  shift
fi

case "$(uname -s)" in
  Darwin) switch_cmd=(sudo darwin-rebuild switch --flake "$ROOT_DIR") ;;
  # `--sudo` builds as the repository's owner and activates as root: plain
  # `sudo nixos-rebuild` makes root read a repository it does not own.
  Linux) switch_cmd=(nixos-rebuild switch --flake "$ROOT_DIR" --sudo) ;;
  *)
    echo "rebuild: unsupported platform: $(uname -s)" >&2
    exit 1
    ;;
esac

# On a host several people apply from (/etc/dotfiles/shared-host, declared by
# modules/nixos/system), switch only from a clean checkout at origin/main.
# Anything else rolls back what someone else applied, or applies work nobody
# else can see. REBUILD_LOCAL=1 overrides, for emergencies only.
shared_marker=/etc/dotfiles/shared-host
if [[ -e "$shared_marker" && -z "${REBUILD_LOCAL:-}" ]]; then
  refuse() {
    {
      echo "rebuild: $(hostname) is shared ($(paste -sd, "$shared_marker")); $1"
      echo "rebuild: refusing to switch. Fix that and rerun; REBUILD_LOCAL=1 overrides, for emergencies only."
    } >&2
    exit 1
  }
  git -C "$ROOT_DIR" fetch --quiet origin main ||
    refuse "could not fetch origin/main to compare against."
  [[ -z "$(git -C "$ROOT_DIR" status --porcelain --untracked-files=no)" ]] ||
    refuse "the checkout has uncommitted changes. Commit and push them, or stash them."
  head="$(git -C "$ROOT_DIR" rev-parse HEAD)"
  upstream="$(git -C "$ROOT_DIR" rev-parse FETCH_HEAD)"
  if [[ "$head" != "$upstream" ]]; then
    if git -C "$ROOT_DIR" merge-base --is-ancestor "$head" "$upstream"; then
      refuse "the checkout is behind origin/main. Pull first: git -C $ROOT_DIR pull --rebase"
    elif git -C "$ROOT_DIR" merge-base --is-ancestor "$upstream" "$head"; then
      refuse "the checkout has commits origin/main lacks. Push them first, so the next person's rebuild keeps them."
    else
      refuse "the checkout and origin/main have diverged. Pull --rebase, then push."
    fi
  fi
fi

if [[ -n "${REBUILD_DRY_RUN:-}" ]]; then
  printf '%q ' "${switch_cmd[@]}" "$@"
  printf '\n'
  exit 0
fi

# A rebuild started from inside a my.services app (an agent working in a bb
# thread runs under app-bb-daemon.service) dies when the switch restarts that app:
# the stop kills the caller, the pipe to switch-to-configuration closes, and
# switch-to-configuration panics (exit 101) after stopping the changed units and
# before starting them, leaving them down. Rerun detached in a transient unit
# outside the app's cgroup, logging to the journal, which survives that.
if [[ "$(uname -s)" == Linux && -z "${REBUILD_DETACHED:-}" ]] &&
  grep -Eq '/app-[a-z0-9-]+\.service' /proc/self/cgroup; then
  unit="rebuild-detached-$(date +%s)"
  detached_args=("$@")
  [[ "$skip_checks" == true ]] && detached_args=(--no-checks "${detached_args[@]}")
  sudo systemd-run --unit="$unit" --collect --no-block --uid="$(id -u)" \
    --working-directory="$PWD" \
    --setenv=REBUILD_DETACHED=1 --setenv=HOME="$HOME" --setenv=PATH="$PATH" \
    --setenv=REBUILD_LOCAL="${REBUILD_LOCAL:-}" \
    "$ROOT_DIR/scripts/rebuild" "${detached_args[@]}"
  echo "rebuild: running from inside an app's cgroup, so detached as $unit."
  echo "rebuild: follow it with: journalctl -fu $unit"
  exit 0
fi

# A failed switch aborts here (set -e) with its own status, before any check.
"${switch_cmd[@]}" "$@"

# Rerun the Tailscale Services reconcile, which re-advertises every declared
# Service, even when the switch left the job alone. A host advertising a new
# Service is approved only if, at that moment, the Service exists and the
# policy auto-approves it, and both come from CI after the push
# (tailscale-services.yml, then tailscale-policy.yml). A host that advertised
# before CI finished is never approved later, so it stays unreachable; rerunning
# rebuild once CI is done fixes it.
if [[ "$(uname -s)" == Linux ]] && systemctl cat tailscale-services.service >/dev/null 2>&1; then
  sudo systemctl restart tailscale-services.service
fi

# my.services restarts still pending (an app waiting for idle), companions
# not running beside their app, and waiters that gave up.
if [[ "$(uname -s)" == Linux ]] && command -v restart-app >/dev/null; then
  restart-app --status || true
fi

if [[ "$skip_checks" == true ]]; then
  exit 0
fi

if [[ "$(uname -s)" == Linux ]]; then
  # GAP [[01M53WTHZ1YAW03WWCCFEV0QY1]] NixOS rebuild runs neither the drift audit nor system-setup.
  echo "rebuild: the drift audit and system-setup status are not wired for NixOS yet; none ran."
  exit 0
fi

audit_output="$(mktemp "${TMPDIR:-/tmp}/rebuild-audit.XXXXXX")"
status_output="$(mktemp "${TMPDIR:-/tmp}/rebuild-status.XXXXXX")" || {
  rm -f "$audit_output"
  exit 1
}
trap 'rm -f "$audit_output" "$status_output"' EXIT

"$ROOT_DIR/scripts/audit-system-discrepancies.sh" >"$audit_output" 2>&1 &
audit_pid=$!
system-setup status --advisory >"$status_output" 2>&1 &
status_pid=$!

audit_status=0
wait "$audit_pid" || audit_status=$?
status_status=0
wait "$status_pid" || status_status=$?

printf '\n==> System audit\n'
cat "$audit_output"
printf '\n==> System setup status\n'
cat "$status_output"

(( audit_status == 0 && status_status == 0 ))
