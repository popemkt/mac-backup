#!/usr/bin/env bash

set -euo pipefail

if [ -n "${GITHUB_SOURCES_ROOT:-}" ]; then
  ROOT_DIR="$(cd "$GITHUB_SOURCES_ROOT" && pwd)"
else
  ROOT_DIR="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  if [ -z "$ROOT_DIR" ]; then
    ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
  fi
fi

GENERATED_JSON="$ROOT_DIR/_sources/generated.json"
NVFETCHER_CONFIG="$ROOT_DIR/nvfetcher.toml"
COMMAND_ROOT="${GITHUB_SOURCES_COMMAND_ROOT:-$ROOT_DIR}"
NVFETCHER_AUTH_ARGS=()

usage() {
  cat <<'EOF'
Usage:
  github-sources check [--best-effort]
  github-sources verify [--best-effort]
  github-sources update [source-name]

Commands:
  check   Freshness: is a newer upstream release available? Exit 10 when
          so, 20 on network/API failure (a warning with --best-effort).
  verify  Consistency: do the committed _sources match nvfetcher.toml
          regenerated at their pinned versions? Exit 11 on a mismatch, 20
          when nvfetcher fails (a warning with --best-effort when offline).
  update  Regenerate versions and hashes with nvfetcher. Optionally update
          exactly one source from nvfetcher.toml.

What each command proves: docs/github-release-packages.md#commands
EOF
}

require_command() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "error: required command not found: $1" >&2
    return 1
  fi
}

prepare_nvfetcher_auth() {
  local auth_dir="$1"
  local keyfile token_json

  NVFETCHER_AUTH_ARGS=()
  if [ -z "${GITHUB_TOKEN:-}" ]; then
    return 0
  fi

  require_command jq
  keyfile="$auth_dir/nvchecker-keyfile.toml"
  token_json="$(printf '%s' "$GITHUB_TOKEN" | jq -Rs .)"
  (
    umask 077
    printf '[keys]\n"github.com" = %s\n' "$token_json" >"$keyfile"
  )
  NVFETCHER_AUTH_ARGS=(--keyfile "$keyfile")
}

# The one way this script runs nvfetcher: a configuration into a build
# directory, with the credentials prepare_nvfetcher_auth set up, if any.
generate_sources() {
  local config="$1" build_dir="$2"
  shift 2
  nvfetcher \
    "${NVFETCHER_AUTH_ARGS[@]}" \
    --config "$config" \
    --build-dir "$build_dir" \
    "$@"
}

print_update_hint() {
  echo "run: cd \"$COMMAND_ROOT\" && nix run .#github-sources -- update" >&2
}

# Verify downloads exactly the pinned artifacts, so those hosts are the network
# it depends on. Any HTTP answer, even an error, proves the host is reachable;
# only a connection-level failure counts as offline.
pinned_artifacts_reachable() {
  local artifact_url
  while IFS= read -r artifact_url; do
    curl \
      --silent \
      --head \
      --location \
      --connect-timeout 2 \
      --max-time 5 \
      --retry 0 \
      --output /dev/null \
      "$artifact_url" || return 1
  done < <(jq -r '.[].src.url // empty' "$GENERATED_JSON")
}

# nvfetcher.toml as JSON: the one reader of the configuration. remarshal is
# already the writer, and every caller runs through the flake app.
config_json() {
  remarshal -if toml -of json "$NVFETCHER_CONFIG"
}

# The committed configuration with every version source replaced by the
# version generated.json pins, so regenerating it reproduces the committed
# outputs exactly when they are consistent, whatever upstream has published.
write_pinned_config() {
  local pinned_config="$1"
  local config unpinned

  config="$(config_json)" || return 11
  unpinned="$(
    jq -r --slurpfile generated "$GENERATED_JSON" '
      keys[] | select($generated[0][.].version == null)
    ' <<<"$config"
  )"
  if [ -n "$unpinned" ]; then
    echo "error: no pinned version in _sources/generated.json for: ${unpinned//$'\n'/ }" >&2
    print_update_hint
    return 11
  fi

  jq --slurpfile generated "$GENERATED_JSON" '
    with_entries(.value.src = {manual: $generated[0][.key].version})
  ' <<<"$config" \
    | remarshal -if json -of toml >"$pinned_config"
}

# A source's list filters: the nvchecker options that narrow which upstream
# versions it may follow. The one place that names them.
LIST_FILTER_KEYS='["include_regex", "exclude_regex", "ignored"]'

# nvfetcher.toml with each source's list filters removed, keeping only the
# sources that declare one; resolving it names the newest release upstream
# offers, which differs from the configured latest while a filter excludes it.
write_unfiltered_config() {
  local unfiltered_config="$1"
  local config

  config="$(config_json)" || return 20
  jq --argjson filters "$LIST_FILTER_KEYS" '
    with_entries(
      select(.value.src | keys | any(IN($filters[])))
      | .value.src |= with_entries(select(.key | IN($filters[]) | not))
    )
  ' <<<"$config" | remarshal -if json -of toml >"$unfiltered_config"
}

check_sources() {
  local best_effort=false
  if [ "${1:-}" = "--best-effort" ]; then
    best_effort=true
    shift
  fi
  if [ "$#" -ne 0 ]; then
    usage >&2
    return 2
  fi

  require_command jq
  require_command nvfetcher
  require_command remarshal

  if [ ! -f "$GENERATED_JSON" ]; then
    echo "error: generated source metadata is missing: $GENERATED_JSON" >&2
    print_update_hint
    return 2
  fi

  local tmpdir
  tmpdir="$(mktemp -d)"
  trap 'rm -rf "$tmpdir"' RETURN
  prepare_nvfetcher_auth "$tmpdir"

  # "Latest" is whatever nvfetcher resolves from the real configuration, the
  # same resolution update performs, so the two cannot disagree. A fresh build
  # directory makes a pinned = true source resolve too, so a frozen pin keeps
  # reporting its newer upstream. --keep-going lets one unreachable upstream
  # cost only its own answer.
  generate_sources "$NVFETCHER_CONFIG" "$tmpdir/latest" --keep-going \
    >"$tmpdir/latest.log" 2>&1 || true
  write_unfiltered_config "$tmpdir/unfiltered.toml" || return
  if [ -s "$tmpdir/unfiltered.toml" ]; then
    generate_sources "$tmpdir/unfiltered.toml" "$tmpdir/unfiltered" --keep-going \
      >"$tmpdir/unfiltered.log" 2>&1 || true
  fi

  local report
  report="$(
    jq -rn \
      --slurpfile committed "$GENERATED_JSON" \
      --argjson config "$(config_json)" \
      --argjson latest "$(cat "$tmpdir/latest/generated.json" 2>/dev/null || echo '{}')" \
      --argjson newest "$(cat "$tmpdir/unfiltered/generated.json" 2>/dev/null || echo '{}')" \
      --argjson filters "$LIST_FILTER_KEYS" '
      $config | keys[] as $name
      | ($committed[0][$name].version // "∅") as $current
      | ($latest[$name].version) as $want
      | ($config[$name].src | keys | any(IN($filters[]))) as $filtered
      | ($newest[$name].version) as $unfiltered
      | if $want == null or ($filtered and $unfiltered == null)
        then "unavailable\t\($name)"
        else
          (if $want != $current
           then "outdated\t\($name): \($current) -> \($want)" else empty end),
          (if $filtered and $unfiltered != $want
           then "excluded\t\($name): newer release \($unfiltered) excluded by its list filters"
           else empty end),
          "checked\t\($name)"
        end
    '
  )"

  local kind line checked=0 outdated=0 excluded=0 unavailable=0
  while IFS=$'\t' read -r kind line; do
    case "$kind" in
      checked) checked=$((checked + 1)) ;;
      outdated)
        printf '%s\n' "$line"
        outdated=$((outdated + 1))
        ;;
      excluded)
        printf '%s\n' "$line"
        excluded=$((excluded + 1))
        ;;
      unavailable)
        echo "warning: skipped $line; nvfetcher could not resolve its upstream" >&2
        unavailable=$((unavailable + 1))
        ;;
    esac
  done <<<"$report"

  if [ "$unavailable" -gt 0 ]; then
    tail -n 20 "$tmpdir/latest.log" >&2
  fi

  if [ "$outdated" -gt 0 ]; then
    print_update_hint
    return 10
  fi

  if [ "$unavailable" -gt 0 ]; then
    if [ "$best_effort" = true ]; then
      echo "Release check passed with unavailable sources." >&2
      return 0
    fi
    return 20
  fi

  echo "Release pins are current ($checked checked, $excluded with a newer release excluded)."
}

verify_sources() {
  local best_effort=false
  if [ "${1:-}" = "--best-effort" ]; then
    best_effort=true
    shift
  fi
  if [ "$#" -ne 0 ]; then
    usage >&2
    return 2
  fi

  require_command curl
  require_command jq
  require_command nvfetcher
  require_command remarshal

  if [ ! -f "$NVFETCHER_CONFIG" ]; then
    echo "error: nvfetcher config is missing: $NVFETCHER_CONFIG" >&2
    return 11
  fi

  local generated_file
  for generated_file in generated.nix generated.json; do
    if [ ! -f "$ROOT_DIR/_sources/$generated_file" ]; then
      echo "error: generated source is missing: $ROOT_DIR/_sources/$generated_file" >&2
      return 11
    fi
  done

  local tmpdir log_file pinned_config
  tmpdir="$(mktemp -d)"
  trap 'rm -rf "$tmpdir"' RETURN
  log_file="$tmpdir/nvfetcher.log"
  pinned_config="$tmpdir/nvfetcher.pinned.toml"
  write_pinned_config "$pinned_config" || return

  if ! generate_sources "$pinned_config" "$tmpdir/_sources" >"$log_file" 2>&1; then
    if [ "$best_effort" = true ] && ! pinned_artifacts_reachable; then
      echo "warning: could not fetch pinned release artifacts while offline; continuing" >&2
      return 0
    fi

    cat "$log_file" >&2
    echo "error: nvfetcher could not regenerate release sources at their pinned versions" >&2
    return 20
  fi

  local mismatch=false
  for generated_file in generated.nix generated.json; do
    if ! cmp -s \
      "$ROOT_DIR/_sources/$generated_file" \
      "$tmpdir/_sources/$generated_file"; then
      mismatch=true
      echo "error: _sources/$generated_file does not match nvfetcher.toml at the pinned versions" >&2
      diff -u \
        "$ROOT_DIR/_sources/$generated_file" \
        "$tmpdir/_sources/$generated_file" \
        || true
    fi
  done

  if [ "$mismatch" = true ]; then
    print_update_hint
    return 11
  fi

  echo "Generated release sources match nvfetcher.toml at their pinned versions."
}

update_sources() {
  if [ "$#" -gt 1 ]; then
    usage >&2
    return 2
  fi

  require_command nvfetcher

  if [ ! -f "$NVFETCHER_CONFIG" ]; then
    echo "error: nvfetcher config is missing: $NVFETCHER_CONFIG" >&2
    return 2
  fi

  local filter="${1:-}"
  # --keep-old preserves co-located non-nvfetcher files such as uv-pins.json.
  local args=(--keep-old)

  if [ -n "$filter" ]; then
    if [[ ! "$filter" =~ ^[A-Za-z0-9._+-]+$ ]]; then
      echo "error: invalid source name: $filter" >&2
      return 2
    fi
    args+=(--filter "^${filter}$")
  fi

  (
    local auth_tmpdir
    auth_tmpdir="$(mktemp -d)"
    trap 'rm -rf "$auth_tmpdir"' EXIT
    prepare_nvfetcher_auth "$auth_tmpdir"
    generate_sources "$NVFETCHER_CONFIG" "$ROOT_DIR/_sources" "${args[@]}"
  )
  git -C "$ROOT_DIR" diff --stat -- _sources
}

command="${1:-}"
if [ -z "$command" ]; then
  usage >&2
  exit 2
fi
shift

case "$command" in
  check)
    check_sources "$@"
    ;;
  verify)
    verify_sources "$@"
    ;;
  update)
    update_sources "$@"
    ;;
  -h | --help | help)
    usage
    ;;
  *)
    echo "error: unknown command: $command" >&2
    usage >&2
    exit 2
    ;;
esac
