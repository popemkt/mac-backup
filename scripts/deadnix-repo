#!/usr/bin/env bash
#
# deadnix over the whole repo, minus the Nix files a generator writes.
#
# A generated file carries what its generator emits (a callPackage signature
# with arguments some outputs never use), and pruning it by hand would be
# undone on the next run. This list is the one place those files are named;
# every caller — the commit gate, CI, the docs — runs this script.
#
# Usage: scripts/deadnix-repo [repo-root]   (default: the current directory)
set -euo pipefail

generated=(
  ./_sources/generated.nix # nvfetcher
  ./tools/kb/bun.nix # bun2nix, from tools/kb/bun.lock
)

cd "${1:-.}"
# `--exclude` takes every path after it, so the scan root goes first.
exec deadnix --fail . --exclude "${generated[@]}"
