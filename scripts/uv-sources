#!/usr/bin/env bash
#
# Manage uv tool version pins in _sources/uv-pins.json.
#
# Mirrors scripts/github-sources: `update` rewrites pins into the working tree
# for review, `check` reports without writing. Nothing is applied until
# apply-system-update rebuilds, so an automatic bump is still a reviewed change.
#
# A pin with track="manual" is reported but never rewritten. Use that to hold a
# version deliberately — Cognee's stores are coupled to its release, so a major
# bump there wants a human decision.
#
# Exit codes match github-sources: 0 nothing to do, 10 updates available
# (check only), 1 could not run.

set -euo pipefail

if [ -n "${UV_SOURCES_ROOT:-}" ]; then
  ROOT_DIR="$(cd "$UV_SOURCES_ROOT" && pwd)"
else
  ROOT_DIR="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  if [ -z "$ROOT_DIR" ]; then
    ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
  fi
fi

PINS="$ROOT_DIR/_sources/uv-pins.json"

usage() {
  cat <<'EOF'
Usage: uv-sources <check|update> [--best-effort]

  check   Report pins that have a newer PyPI release. Writes nothing.
  update  Rewrite track="latest" pins to the newest PyPI release.

Options:
  --best-effort  Warn instead of failing when the command cannot run.
EOF
}

best_effort=false
command=""

while [ $# -gt 0 ]; do
  case "$1" in
    check | update) command="$1" ;;
    --best-effort) best_effort=true ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      usage >&2
      exit 1
      ;;
  esac
  shift
done

[ -n "$command" ] || {
  usage >&2
  exit 1
}

if [ ! -f "$PINS" ]; then
  if [ "$best_effort" = true ]; then
    printf 'warning: %s is missing\n' "$PINS" >&2
    exit 0
  fi
  printf 'error: %s is missing\n' "$PINS" >&2
  exit 1
fi

set +e
UV_PINS_FILE="$PINS" UV_SOURCES_MODE="$command" python3 - <<'PY'
import json, os, sys, urllib.error, urllib.request

path = os.environ["UV_PINS_FILE"]
mode = os.environ["UV_SOURCES_MODE"]

with open(path) as fh:
    pins = json.load(fh)


def latest(name):
    with urllib.request.urlopen(f"https://pypi.org/pypi/{name}/json", timeout=15) as resp:
        return json.load(resp)["info"]["version"]


bumped, held, failed = [], [], []
for name in sorted(pins):
    entry = pins[name]
    current = entry["version"]
    try:
        newest = latest(name)
    except (urllib.error.URLError, OSError, KeyError, ValueError) as exc:
        failed.append((name, str(exc)[:80]))
        continue
    if newest == current:
        continue
    if entry.get("track", "latest") != "latest":
        held.append((name, current, newest))
        continue
    bumped.append((name, current, newest))
    if mode == "update":
        entry["version"] = newest

for name, current, newest in bumped:
    verb = "->" if mode == "update" else "-> available"
    print(f"{name}: {current} {verb} {newest}")
for name, current, newest in held:
    print(f"{name}: {current} -> {newest} (held; track=manual)")
for name, why in failed:
    print(f"warning: {name}: {why}", file=sys.stderr)

if mode == "update" and bumped:
    with open(path, "w") as fh:
        json.dump(pins, fh, indent=2, sort_keys=True)
        fh.write("\n")
    print("Rewrote uv pins. Review with: git diff -- _sources/uv-pins.json")

if failed:
    sys.exit(1)
if not bumped and not held:
    print("uv tool pins are current.")
    sys.exit(0)
# `update` already applied the change, so only `check` signals work pending.
sys.exit(10 if mode == "check" and bumped else 0)
PY
status=$?
set -e

if [ "$status" -eq 1 ] && [ "$best_effort" = true ]; then
  printf 'warning: uv pin check could not complete\n' >&2
  exit 0
fi

exit "$status"
