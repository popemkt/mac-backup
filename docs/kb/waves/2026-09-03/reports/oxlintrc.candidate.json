{
  "plugins": ["eslint", "typescript", "react", "import", "unicorn", "oxc", "promise", "node"],
  "categories": { "correctness": "error", "suspicious": "error", "perf": "error" },
  "rules": {
    "import/no-cycle": "error",
    "import/no-duplicates": "error",
    "import/no-self-import": "error",
    "import/no-empty-named-blocks": "error",
    "typescript/ban-ts-comment": ["error", { "ts-expect-error": "allow-with-description" }],
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/consistent-type-imports": ["error", { "fixStyle": "inline-type-imports" }],
    "typescript/no-import-type-side-effects": "error",
    "typescript/consistent-type-assertions": ["error", { "assertionStyle": "as", "objectLiteralTypeAssertions": "never" }],
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-unsafe-type-assertion": "error",
    "typescript/no-redundant-type-constituents": "error",
    "typescript/no-base-to-string": "error",
    "typescript/no-deprecated": "error",
    "typescript/await-thenable": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/require-await": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/no-unnecessary-condition": "error",
    "typescript/strict-boolean-expressions": "error",
    "typescript/restrict-template-expressions": "error",
    "typescript/no-implied-eval": "error",
    "typescript/no-misused-spread": "error",
    "typescript/require-array-sort-compare": "error",
    "typescript/unbound-method": "error",
    "typescript/array-type": ["error", { "default": "generic", "readonly": "generic" }],
    "typescript/no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
    "typescript/no-unnecessary-type-constraint": "error",
    "typescript/no-useless-empty-export": "error",
    "promise/always-return": "error",
    "promise/catch-or-return": "error",
    "eslint/no-console": "error",
    "eslint/no-var": "error",
    "eslint/prefer-const": "error",
    "eslint/no-eq-null": "error",
    "eslint/default-case": "error",
    "eslint/no-shadow": "error",
    "eslint/no-useless-constructor": "error",
    "eslint/no-unneeded-ternary": "error",
    "eslint/no-useless-concat": "error",
    "eslint/complexity": ["error", 20],
    "eslint/max-depth": ["error", 5],
    "eslint/max-nested-callbacks": ["error", 4],
    "eslint/max-lines-per-function": ["warn", { "max": 120 }],
    "eslint/max-params": ["warn", 5],
    "eslint/max-lines": ["warn", { "max": 900 }],
    "oxc/no-accumulating-spread": "error",
    "oxc/no-map-spread": "error",
    "oxc/misrefactored-assign-op": "error",
    "unicorn/no-abusive-eslint-disable": "error",
    "unicorn/prefer-array-flat-map": "error",
    "unicorn/no-accessor-recursion": "error",
    "unicorn/consistent-function-scoping": "warn",
    "node/no-process-env": "error",
    "react/exhaustive-deps": "error",
    "react/rules-of-hooks": "error",
    "react/button-has-type": "error",
    "react/no-danger": "error",
    "react/no-array-index-key": "error",
    "react/only-export-components": ["error", { "allowConstantExport": true }],
    "react/react-in-jsx-scope": "off"
  }
}
