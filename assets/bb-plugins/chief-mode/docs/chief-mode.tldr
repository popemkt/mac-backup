                  "text": "Why the hold",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ]
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "The role is written before the first turn starts, so that turn's session is already offered the architect's tools."
                }
              ]
            },
            {
              "type": "paragraph"
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "If a step fails",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ]
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "handoff still returns, with a warning that names the command to finish by hand, e.g. bb tasks attach DOT-n --thread thr_…"
                }
              ]
            }
          ]
        }
      },
      "index": "aAHDQ",
      "typeName": "shape"
    },
