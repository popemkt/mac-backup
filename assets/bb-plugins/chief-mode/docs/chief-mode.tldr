              "content": [
                {
                  "type": "text",
                  "text": "The table is read twice. agents.configure offers a session its role's tools, keyed on the thread's plugin metadata. Every tool also re-checks the caller's role from fresh metadata and refuses otherwise, because a session's tools are fixed when the session starts."
                }
              ]
            }
          ]
        }
