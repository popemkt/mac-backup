{
  "compilerOptions": {
    "strict": true,
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "lib": ["ES2023", "ESNext.Disposable"],
    "types": ["node"],
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["server.ts", "core", "sdk", "tests"]
}
