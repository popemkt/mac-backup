// Tailnet policy source of truth.
//
// The final grant preserves broad access to devices. Each Service has its
// own grant.
{
  "tagOwners": {
    "tag:home-server": ["autogroup:admin"],
    "tag:orca-host": ["autogroup:admin"],
    "tag:shared-server": ["autogroup:admin"],
  },

  "grants": [
    // Orca Mobile connects directly to Orca hosts over MagicDNS.
    {
      "src": ["autogroup:member"],
      "dst": ["tag:orca-host"],
      "ip": ["tcp:6768"],
    },

    // Member-facing Services are also used from tagged machines. For example,
    // the work Mac calls Cognee, and bb on shared-server reads kb-work.
    {
      "src": ["autogroup:member", "tag:home-server", "tag:orca-host", "tag:shared-server"],
      "dst": [
        "svc:adhoc",
        "svc:adhoc-popemkt",
        "svc:axioms-popemkt",
        "svc:bb-bytetum",
        "svc:bb-popemkt",
        "svc:cognee",
        "svc:kb",
        "svc:kb-bytetum",
        "svc:kb-popemkt",
        "svc:kb-work",
        "svc:marginalia-bytetum",
        "svc:t3-bytetum",
        "svc:t3-popemkt",
      ],
      "ip": ["tcp:443"],
    },

    // popemkt's own devices reach the private phone endpoints.
    {
      "src": ["hoangng71299@gmail.com"],
      "dst": ["svc:kb-capture-popemkt"],
      "ip": ["tcp:443"],
    },

    // The people on the shared server reach its Tailscale SSH server; the
    // `ssh` block below decides which account each one may log in as.
    // popemkt's Macs are tagged, so they connect as their tags, not as him.
    {
      "src": [
        "hoangng71299@gmail.com",
        "bytetum@github",
        "tag:home-server",
        "tag:orca-host",
      ],
      "dst": ["tag:shared-server"],
      "ip": ["tcp:22"],
    },

    // Preserve direct access to user-owned and declared tagged devices.
    // Service destinations and subnet routes need their own grants.
    {
      "src": ["*"],
      "dst": ["autogroup:member", "tag:home-server", "tag:orca-host", "tag:shared-server"],
      "ip": ["*"],
    },
  ],

  // A tagged home server can approve itself as a host for the service.
  "autoApprovers": {
    "services": {
      "svc:kb": ["tag:home-server"],
      "svc:adhoc": ["tag:home-server"],
      "svc:cognee": ["tag:home-server"],
      "svc:t3-popemkt": ["tag:shared-server"],
      "svc:t3-bytetum": ["tag:shared-server"],
      "svc:kb-popemkt": ["tag:shared-server"],
      "svc:kb-bytetum": ["tag:shared-server"],
      "svc:kb-capture-popemkt": ["tag:shared-server"],
      "svc:kb-work": ["tag:orca-host"],
      "svc:marginalia-bytetum": ["tag:shared-server"],
      "svc:adhoc-popemkt": ["tag:shared-server"],
      "svc:bb-popemkt": ["tag:shared-server"],
      "svc:bb-bytetum": ["tag:shared-server"],
      "svc:axioms-popemkt": ["tag:shared-server"],
    },
  },

  "ssh": [
    // Preserve Tailscale's default check-mode SSH access to a user's own node.
    {
      "action": "check",
      "src": ["autogroup:member"],
      "dst": ["autogroup:self"],
      "users": ["autogroup:nonroot", "root"],
    },

    // Each person logs in to the shared server as their own account, from
    // their own devices and, for popemkt, from his tagged Macs (their agents
    // included). "accept", not "check": check mode needs a browser sign-in
    // that an agent cannot do. Root stays behind sudo.
    {
      "action": "accept",
      "src": ["hoangng71299@gmail.com", "tag:home-server", "tag:orca-host"],
      "dst": ["tag:shared-server"],
      "users": ["popemkt"],
    },
    {
      "action": "accept",
      "src": ["bytetum@github"],
      "dst": ["tag:shared-server"],
      "users": ["bytetum"],
    },
  ],

  "tests": [
    {
      "src": "tag:orca-host",
      "accept": ["svc:cognee:443", "svc:bb-popemkt:443"],
    },
    {
      "src": "tag:shared-server",
      "accept": ["svc:kb-work:443"],
    },
    // Exercise the private-device grant against its existing Service identity.
    {
      "src": "hoangng71299@gmail.com",
      "accept": ["svc:kb-capture-popemkt:443"],
    },
    {
      "src": "bytetum@github",
      "deny": ["svc:kb-capture-popemkt:443"],
    },
  ],

  "sshTests": [
    {
      "src": "tag:orca-host",
      "dst": ["tag:shared-server"],
      "accept": ["popemkt"],
      "deny": ["bytetum", "root"],
    },
    {
      "src": "bytetum@github",
      "dst": ["tag:shared-server"],
      "accept": ["bytetum"],
      "deny": ["popemkt", "root"],
    },
  ],
}
