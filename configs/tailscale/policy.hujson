// Tailnet policy source of truth.
//
// The final wildcard grant preserves the tailnet's existing unrestricted
// behavior. The explicit service grants document the durable contracts we
// rely on and let us remove the wildcard safely in a later tightening pass.
{
  "tagOwners": {
    "tag:home-server": ["autogroup:admin"],
    // popemkt's own Macs.
    "tag:personal-device": ["autogroup:admin"],
    // Retired: the Macs' old tag, kept with the same rights as
    // tag:personal-device until they are retagged; every tag:orca-host entry
    // goes then.
    // GAP [[01M8B0VEEWTZ8608V6V17GJ1YE]]: remove tag:orca-host after the retag.
    "tag:orca-host": ["autogroup:admin"],
    "tag:shared-server": ["autogroup:admin"],
  },

  "grants": [
    // Reserved for ntfy when the owner enables its tailnet exposure.
    {
      "src": ["hoangng71299@gmail.com"],
      "dst": ["svc:ntfy-popemkt"],
      "ip": ["tcp:443"],
    },

    // Remote Cognee clients use the Tailscale Service HTTPS endpoint.
    {
      "src": ["autogroup:member"],
      "dst": ["svc:cognee"],
      "ip": ["tcp:443"],
    },

    // Tailnet members can reach the home knowledge base over HTTPS.
    {
      "src": ["autogroup:member"],
      "dst": ["svc:kb"],
      "ip": ["tcp:443"],
    },

    // Tailnet members can reach a temporary app on the reserved ad hoc port.
    {
      "src": ["autogroup:member"],
      "dst": ["svc:adhoc"],
      "ip": ["tcp:443"],
    },

    // Both people on the shared server reach both T3 Code servers.
    {
      "src": ["autogroup:member"],
      "dst": ["svc:t3-popemkt", "svc:t3-bytetum"],
      "ip": ["tcp:443"],
    },

    // Tailnet members can reach the shared-server kb graphs and the
    // separate work graph on popemkt-work.
    {
      "src": ["autogroup:member"],
      "dst": ["svc:kb-popemkt", "svc:kb-bytetum", "svc:kb-work"],
      "ip": ["tcp:443"],
    },

    // popemkt's own devices (the phone's kb app) reach popemkt's kb capture-only
    // listener: pairing with a code issued on the host, then delivery with
    // the device's bearer token. Nobody else's devices.
    // GAP [[01M7WTAJYW03B2N9ZS36ZJHZ8G]]: the wildcard grant below still
    // admits every member until the tightening pass removes it.
    {
      "src": ["hoangng71299@gmail.com"],
      "dst": ["svc:kb-capture-popemkt"],
      "ip": ["tcp:443"],
    },

    // popemkt's bb on the shared server calls the work graph for its agent
    // tools (the kb plugin's kb-work store). The owner accepted that the
    // shared server's administrators can reach kb-work through this grant.
    {
      "src": ["tag:shared-server"],
      "dst": ["svc:kb-work"],
      "ip": ["tcp:443"],
    },

    // Tailnet members can reach bytetum's Marginalia on the shared server.
    // The app's bearer token is its own access control.
    {
      "src": ["autogroup:member"],
      "dst": ["svc:marginalia-bytetum"],
      "ip": ["tcp:443"],
    },

    // Tailnet members can reach popemkt's temporary app on the shared server.
    {
      "src": ["autogroup:member"],
      "dst": ["svc:adhoc-popemkt"],
      "ip": ["tcp:443"],
    },

    // Tailnet members can reach popemkt's and bytetum's bb servers on the
    // shared server. bb's API is unauthenticated, so this grant is its only
    // access control.
    {
      "src": ["autogroup:member"],
      "dst": ["svc:bb-popemkt", "svc:bb-bytetum"],
      "ip": ["tcp:443"],
    },

    // Tailnet members can reach popemkt's axioms on the shared server: the UI,
    // its API, and the SpacetimeDB websocket it relays. Its reducers trust
    // any caller, so this grant is its only access control.
    {
      "src": ["autogroup:member"],
      "dst": ["svc:axioms-popemkt"],
      "ip": ["tcp:443"],
    },

    // popemkt's own devices, his Macs included, reach the shared server's
    // Beszel dashboard (docs/monitoring.md). Its identity proxy asks
    // tailscaled who each caller is and shows the dashboard only to
    // popemkt's login and to tag:personal-device, so other members and
    // other tags see no data even through the wildcard grant below.
    {
      "src": ["hoangng71299@gmail.com", "tag:personal-device"],
      "dst": ["svc:beszel-shared-server"],
      "ip": ["tcp:443"],
    },

    // The people on the shared server reach its Tailscale SSH server; the
    // `ssh` block below decides which account each one may log in as.
    // popemkt's Macs are tagged, so they connect as their tags, not as him.
    {
      "src": [
        "hoangng71299@gmail.com",
        "bytetum@github",
        "tag:home-server",
        "tag:personal-device",
        // GAP [[01M8B0VEEWTZ8608V6V17GJ1YE]]: retired; remove after the retag.
        "tag:orca-host",
      ],
      "dst": ["tag:shared-server"],
      "ip": ["tcp:22"],
    },

    // Preserve the pre-existing default policy until every remaining flow is
    // inventoried and covered by a narrower grant.
    {
      "src": ["*"],
      "dst": ["*"],
      "ip": ["*"],
    },
  ],

  // A tagged home server can approve itself as a host for the service.
  "autoApprovers": {
    "services": {
      "svc:kb": ["tag:home-server"],
      "svc:adhoc": ["tag:home-server"],
      "svc:cognee": ["tag:home-server"],
      "svc:t3-popemkt": ["tag:shared-server"],
      "svc:t3-bytetum": ["tag:shared-server"],
      "svc:kb-popemkt": ["tag:shared-server"],
      "svc:kb-bytetum": ["tag:shared-server"],
      "svc:kb-capture-popemkt": ["tag:shared-server"],
      "svc:ntfy-popemkt": ["tag:shared-server"],
      // GAP [[01M8B0VEEWTZ8608V6V17GJ1YE]]: tag:orca-host retired; remove after the retag.
      "svc:kb-work": ["tag:personal-device", "tag:orca-host"],
      "svc:marginalia-bytetum": ["tag:shared-server"],
      "svc:adhoc-popemkt": ["tag:shared-server"],
      "svc:bb-popemkt": ["tag:shared-server"],
      "svc:bb-bytetum": ["tag:shared-server"],
      "svc:axioms-popemkt": ["tag:shared-server"],
      "svc:beszel-shared-server": ["tag:shared-server"],
    },
  },

  // Funnel: the tags whose machines may publish an entry on the internet.
  // A machine publishes only what it declares with
  // my.stacks.vpn.nodeServe.<name>.funnel (shared-server: the MCP edge's
  // allow-listed paths, docs/mcp-edge.md); scripts/check-tailscale-policy.sh
  // fails a declared Funnel whose host has no tag here.
  "nodeAttrs": [
    {
      "target": ["tag:shared-server"],
      "attr": ["funnel"],
    },
  ],

  "ssh": [
    // Preserve Tailscale's default check-mode SSH access to a user's own node.
    {
      "action": "check",
      "src": ["autogroup:member"],
      "dst": ["autogroup:self"],
      "users": ["autogroup:nonroot", "root"],
    },

    // Each person logs in to the shared server as their own account, from
    // their own devices and, for popemkt, from his tagged Macs (their agents
    // included). "accept", not "check": check mode needs a browser sign-in
    // that an agent cannot do. Root stays behind sudo.
    // GAP [[01M8B0VEEWTZ8608V6V17GJ1YE]]: tag:orca-host retired; remove after the retag.
    {
      "action": "accept",
      "src": [
        "hoangng71299@gmail.com",
        "tag:home-server",
        "tag:personal-device",
        "tag:orca-host",
      ],
      "dst": ["tag:shared-server"],
      "users": ["popemkt"],
    },
    {
      "action": "accept",
      "src": ["bytetum@github"],
      "dst": ["tag:shared-server"],
      "users": ["bytetum"],
    },
  ],

  "sshTests": [
    {
      "src": "tag:personal-device",
      "dst": ["tag:shared-server"],
      "accept": ["popemkt"],
      "deny": ["bytetum", "root"],
    },
    // GAP [[01M8B0VEEWTZ8608V6V17GJ1YE]]: tag:orca-host retired; remove after the retag.
    {
      "src": "tag:orca-host",
      "dst": ["tag:shared-server"],
      "accept": ["popemkt"],
      "deny": ["bytetum", "root"],
    },
    {
      "src": "bytetum@github",
      "dst": ["tag:shared-server"],
      "accept": ["bytetum"],
      "deny": ["popemkt", "root"],
    },
  ],
}
