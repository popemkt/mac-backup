// Tailnet policy source of truth.
//
// The final wildcard grant preserves the tailnet's existing unrestricted
// behavior. The explicit service grants document the durable contracts we
// rely on and let us remove the wildcard safely in a later tightening pass.
{
  "tagOwners": {
    "tag:home-server": ["autogroup:admin"],
    "tag:orca-host": ["autogroup:admin"],
    "tag:shared-server": ["autogroup:admin"],
  },

  "grants": [
    // Orca Mobile connects directly to Orca hosts over MagicDNS.
    {
      "src": ["autogroup:member"],
      "dst": ["tag:orca-host"],
      "ip": ["tcp:6768"],
    },

    // Remote Cognee clients use the Tailscale Service HTTPS endpoint.
    {
      "src": ["autogroup:member"],
      "dst": ["svc:cognee"],
      "ip": ["tcp:443"],
    },

    // Tailnet members can reach the home knowledge base over HTTPS.
    {
      "src": ["autogroup:member"],
      "dst": ["svc:kb"],
      "ip": ["tcp:443"],
    },

    // Tailnet members can reach a temporary app on the reserved ad hoc port.
    {
      "src": ["autogroup:member"],
      "dst": ["svc:adhoc"],
      "ip": ["tcp:443"],
    },

    // Both people on the shared server reach both T3 Code servers.
    {
      "src": ["autogroup:member"],
      "dst": ["svc:t3-popemkt", "svc:t3-bytetum"],
      "ip": ["tcp:443"],
    },

    // Tailnet members can reach popemkt's and bytetum's kb graphs on the
    // shared server.
    {
      "src": ["autogroup:member"],
      "dst": ["svc:kb-popemkt", "svc:kb-bytetum"],
      "ip": ["tcp:443"],
    },

    // Tailnet members can reach bytetum's Marginalia on the shared server.
    // The app's bearer token is its own access control.
    {
      "src": ["autogroup:member"],
      "dst": ["svc:marginalia-bytetum"],
      "ip": ["tcp:443"],
    },

    // Tailnet members can reach popemkt's temporary app on the shared server.
    {
      "src": ["autogroup:member"],
      "dst": ["svc:adhoc-popemkt"],
      "ip": ["tcp:443"],
    },

    // Tailnet members can reach popemkt's bb server on the shared server.
    // bb's API is unauthenticated, so this grant is its only access control.
    {
      "src": ["autogroup:member"],
      "dst": ["svc:bb-popemkt"],
      "ip": ["tcp:443"],
    },

    // Tailnet members can reach popemkt's axioms on the shared server: the UI,
    // its API, and the SpacetimeDB websocket it relays. Its reducers trust
    // any caller, so this grant is its only access control.
    {
      "src": ["autogroup:member"],
      "dst": ["svc:axioms-popemkt"],
      "ip": ["tcp:443"],
    },

    // The people on the shared server reach its Tailscale SSH server; the
    // `ssh` block below decides which account each one may log in as.
    // popemkt's Macs are tagged, so they connect as their tags, not as him.
    {
      "src": [
        "hoangng71299@gmail.com",
        "bytetum@github",
        "tag:home-server",
        "tag:orca-host",
      ],
      "dst": ["tag:shared-server"],
      "ip": ["tcp:22"],
    },

    // Preserve the pre-existing default policy until every remaining flow is
    // inventoried and covered by a narrower grant.
    {
      "src": ["*"],
      "dst": ["*"],
      "ip": ["*"],
    },
  ],

  // A tagged home server can approve itself as a host for the service.
  "autoApprovers": {
    "services": {
      "svc:kb": ["tag:home-server"],
      "svc:adhoc": ["tag:home-server"],
      "svc:cognee": ["tag:home-server"],
      "svc:t3-popemkt": ["tag:shared-server"],
      "svc:t3-bytetum": ["tag:shared-server"],
      "svc:kb-popemkt": ["tag:shared-server"],
      "svc:kb-bytetum": ["tag:shared-server"],
      "svc:marginalia-bytetum": ["tag:shared-server"],
      "svc:adhoc-popemkt": ["tag:shared-server"],
      "svc:bb-popemkt": ["tag:shared-server"],
      "svc:axioms-popemkt": ["tag:shared-server"],
    },
  },

  "ssh": [
    // Preserve Tailscale's default check-mode SSH access to a user's own node.
    {
      "action": "check",
      "src": ["autogroup:member"],
      "dst": ["autogroup:self"],
      "users": ["autogroup:nonroot", "root"],
    },

    // Each person logs in to the shared server as their own account, from
    // their own devices and, for popemkt, from his tagged Macs (their agents
    // included). "accept", not "check": check mode needs a browser sign-in
    // that an agent cannot do. Root stays behind sudo.
    {
      "action": "accept",
      "src": ["hoangng71299@gmail.com", "tag:home-server", "tag:orca-host"],
      "dst": ["tag:shared-server"],
      "users": ["popemkt"],
    },
    {
      "action": "accept",
      "src": ["bytetum@github"],
      "dst": ["tag:shared-server"],
      "users": ["bytetum"],
    },
  ],

  "sshTests": [
    {
      "src": "tag:orca-host",
      "dst": ["tag:shared-server"],
      "accept": ["popemkt"],
      "deny": ["bytetum", "root"],
    },
    {
      "src": "bytetum@github",
      "dst": ["tag:shared-server"],
      "accept": ["bytetum"],
      "deny": ["popemkt", "root"],
    },
  ],
}
