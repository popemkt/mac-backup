# Nix
result
result-*
.direnv/
.venv/
.pytest_cache/
.ruff_cache/
__pycache__/

# macOS
.DS_Store
.playwright-mcp/
.tokensave/

# Secrets (never commit these)
.env
.env.*
*.secret
*.private
secrets/
.claude/settings.local.json
.codex/config.toml

# kb ui (Vite build + deps)
tools/kb/ui/dist/
tools/kb/ui/storybook-static/
tools/kb/ui/node_modules/

# kb opaque media files (W6a) — never commit binaries. No trailing slash so a
# future Mackup symlink is also ignored, not just the real directory. Backup
# ownership is declared in modules/darwin/home-manager/mackup.nix.
.kb/assets
.research/

# kb JsonlStore atomic-write artifacts (backup + tmp; live nodes.jsonl stays tracked)
*.bak
.kb/nodes.jsonl.bak
.kb/nodes.jsonl.lock
.kb/nodes.jsonl.*.tmp
.kb/cache/

# kb SqliteStore derived files (the live kb.sqlite stays tracked, as nodes.jsonl does)
.kb/kb.sqlite-wal
.kb/kb.sqlite-shm

# kb transaction tail — the JSONL store's durable log of what changed, in what
# order. State, not intent: the nodes are the repo's content and this is how
# they got there, so it is a backup concern (docs/backup-strategy.md) and never
# committed. The sqlite store keeps its tail inside kb.sqlite, which is.
.kb/tx.jsonl
.kb/tx.jsonl.lock
.kb/tx.jsonl.*.tmp

# Claude Code agent worktrees
.claude/worktrees/
